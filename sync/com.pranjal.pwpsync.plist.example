<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pranjal.pwpsync</string>

  <key>ProgramArguments</key>
  <array>
    <!-- REPLACE with the absolute path from `which node` (launchd has no nvm PATH) -->
    <string>/Users/REPLACE_ME/.nvm/versions/node/vX.Y.Z/bin/node</string>
    <string>sync.mjs</string>
  </array>

  <!-- REPLACE with the absolute path to this repo's sync/ directory -->
  <key>WorkingDirectory</key>
  <string>/Users/REPLACE_ME/workplace/pwp-wedding-app/sync</string>

  <!-- wacli must be on PATH; Homebrew installs it under /opt/homebrew/bin -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/pwpsync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/pwpsync.err.log</string>
</dict>
</plist>
