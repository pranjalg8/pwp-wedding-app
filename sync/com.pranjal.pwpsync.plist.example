<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pranjal.pwpsync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>sync.mjs</string>
  </array>

  <!-- REPLACE with the absolute path to this repo's sync/ directory -->
  <key>WorkingDirectory</key>
  <string>/Users/REPLACE_ME/workplace/pwp-wedding-app/sync</string>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>StandardOutPath</key>
  <string>/tmp/pwpsync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pwpsync.err.log</string>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
